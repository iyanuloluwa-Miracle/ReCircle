# Copy to .env. Never commit real credentials.
# These aliases are read on the server at request time, including production.
MONGODB_URI=
# Local demo seed only; at least 12 characters. Never commit a real value.
DEMO_SEED_PASSWORD=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
BYTESHIP_API_KEY=
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NUXT_PUBLIC_APP_URL=http://localhost:3000
# Paystack TEST keys only (sk_test_ / pk_test_). Live keys are rejected.
# Recycler top-up uses Checkout; credit via webhook POST /api/paystack/webhook
# (charge.success) and/or verify-on-return. Consumer withdraw uses Transfers.
# Leave empty to use demo top-up / demo withdraw locally.
# Webhook URL must be publicly reachable (tunnel for localhost).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Set to 1 to log payout/top-up decisions as [recircle:payout] and expose
# GET /api/debug/payout-log plus payoutDebug on completed status responses.
PAYOUT_DEBUG=
# Resend email OTP for signup. Without a key, OTP is logged in development only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ReCircle <onboarding@yourdomain.com>
# Google Identity Services (OAuth Web client ID). Also exposed as NUXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google Maps Platform. Enable Geocoding, Places, and Maps JavaScript APIs.
# Server key for Geocoding (keep secret). Browser key for Places Autocomplete + map (HTTP referrer restricted).
GOOGLE_MAPS_API_KEY=
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=
